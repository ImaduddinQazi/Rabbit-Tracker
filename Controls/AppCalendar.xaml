<UserControl x:Class="HabitTracker.Controls.AppCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14">
        <StackPanel>

            <!-- Header: « ‹ Month Year › » -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnPrevYear" Grid.Column="0" Content="&#171;" Width="26" Height="28"
                        Style="{DynamicResource CalendarNavButtonStyle}" Click="BtnPrevYear_Click" ToolTip="Previous year"/>
                <Button x:Name="BtnPrevMonth" Grid.Column="1" Content="&#8249;" Width="26" Height="28"
                        Style="{DynamicResource CalendarNavButtonStyle}" Click="BtnPrevMonth_Click" ToolTip="Previous month"/>

                <Button x:Name="BtnMonthYear" Grid.Column="2"
                        Style="{DynamicResource CalendarMonthButtonStyle}"
                        Click="BtnMonthYear_Click" ToolTip="Jump to a year"/>

                <Button x:Name="BtnNextMonth" Grid.Column="3" Content="&#8250;" Width="26" Height="28"
                        Style="{DynamicResource CalendarNavButtonStyle}" Click="BtnNextMonth_Click" ToolTip="Next month"/>
                <Button x:Name="BtnNextYear" Grid.Column="4" Content="&#187;" Width="26" Height="28"
                        Style="{DynamicResource CalendarNavButtonStyle}" Click="BtnNextYear_Click" ToolTip="Next year"/>
            </Grid>

            <!-- Weekday labels -->
            <UniformGrid x:Name="WeekdayHeader" Columns="7" Margin="0,0,0,4"/>

            <!-- Day cells -->
            <Grid x:Name="DaysGrid"/>

            <!-- Year-jump popup (opened by clicking the month/year label) -->
            <Popup x:Name="YearPopup" PlacementTarget="{Binding ElementName=BtnMonthYear}"
                   StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderColorBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="6">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="YearListPanel" Width="120"/>
                    </ScrollViewer>
                </Border>
            </Popup>

        </StackPanel>
    </Border>
</UserControl>
