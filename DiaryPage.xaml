<Page x:Class="HabitTracker.DiaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:HabitTracker.Controls"
      Background="{DynamicResource WindowBackgroundBrush}"
      Title="Diary">

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Calendar + Bookmarks -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,15,0">
            <DockPanel>

                <!-- Search across all diary entries -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBox x:Name="TxtSearch" Style="{DynamicResource AppTextBoxStyle}" Padding="10,9,32,9"
                             TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Text="&#128269;" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>

                    <Popup x:Name="SearchResultsPopup" PlacementTarget="{Binding ElementName=TxtSearch}"
                           StaysOpen="False" AllowsTransparency="True" Placement="Bottom" Width="228">
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                <StackPanel x:Name="SearchResultsPanel"/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <controls:AppCalendar x:Name="Calendar" DockPanel.Dock="Top" Margin="0,0,0,14"
                                      DateSelected="Calendar_DateSelected"/>

                <!-- Legend -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource SuccessBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="Logged" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,10,0"/>
                    <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource WarningBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="Bookmarked" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                </StackPanel>

                <Button Content="Today" DockPanel.Dock="Top" Height="34" Margin="0,0,0,20"
                        Style="{DynamicResource SecondaryButtonStyle}" Click="BtnToday_Click"/>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Bookmarks"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,0,0,10"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BookmarksPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Right Panel: Diary Editor -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="&#8249;" Width="36" Height="36" Click="BtnPrev_Click" Style="{DynamicResource CalendarNavButtonStyle}"/>

                <TextBlock x:Name="TxtCurrentDate"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0"/>

                <Button Content="&#8250;" Width="36" Height="36" Click="BtnNext_Click"
                        Style="{DynamicResource CalendarNavButtonStyle}" Margin="0,0,15,0"/>

                <Button x:Name="BtnBookmark"
                        Content="Bookmark"
                        Width="110"
                        Height="36"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Click="BtnBookmark_Click"/>

                <Button x:Name="BtnClearText"
                        Content="Clear Text"
                        Width="100"
                        Height="36"
                        Margin="10,0,0,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Click="BtnClearText_Click"
                        ToolTip="Clear all text for this day's entry"/>
            </StackPanel>

            <TextBox x:Name="TxtContent"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="15"
                     Padding="15"
                     Background="{DynamicResource CardBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderColorBrush}"
                     CaretBrush="White"
                     TextChanged="TxtContent_TextChanged"/>

            <TextBlock x:Name="TxtStatus"
                       Grid.Row="2"
                       Text="Ready"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12"
                       Margin="0,10,0,0"/>
        </Grid>
    </Grid>
</Page>
