<Page x:Class="HabitTracker.DiaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E1E"
      Title="Diary">

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Navigation + Bookmarks -->
        <Border Grid.Column="0" Background="#252526" CornerRadius="8" Padding="15" Margin="0,0,15,0">
            <DockPanel>
                <!-- Date Navigation -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Go to Date" Foreground="#AAAAAA" FontSize="13" Margin="0,0,0,8"/>
                    
                    <DatePicker x:Name="DpJump" 
                                SelectedDateChanged="DpJump_SelectedDateChanged"
                                Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Content="← Prev" Width="85" Height="32" Click="BtnPrev_Click" Margin="0,0,8,0"/>
                        <Button Content="Next →" Width="85" Height="32" Click="BtnNext_Click"/>
                    </StackPanel>

                    <Button Content="Today" Height="32" Click="BtnToday_Click" Margin="0,0,0,25"/>
                </StackPanel>

                <!-- Bookmarks -->
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" 
                               Text="Bookmarks" 
                               Foreground="#AAAAAA" 
                               FontSize="13" 
                               Margin="0,0,0,10"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BookmarksPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Right Panel: Writing Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock x:Name="TxtCurrentDate"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <Button x:Name="BtnBookmark"
                        Content="Bookmark"
                        Width="100"
                        Height="34"
                        Margin="20,0,0,0"
                        Background="#3F3F46"
                        Foreground="White"
                        BorderThickness="0"
                        Click="BtnBookmark_Click"/>
            </StackPanel>

            <!-- Editor -->
            <TextBox x:Name="TxtContent"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="15"
                     Padding="15"
                     Background="#2D2D30"
                     Foreground="White"
                     BorderBrush="#3F3F46"
                     CaretBrush="White"
                     TextChanged="TxtContent_TextChanged"/>

            <!-- Status -->
            <TextBlock x:Name="TxtStatus"
                       Grid.Row="2"
                       Text="Ready"
                       Foreground="#666666"
                       FontSize="12"
                       Margin="0,10,0,0"/>
        </Grid>
    </Grid>
</Page>