<Window x:Class="HabitTracker.AddReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Add Reminder"
        Height="420" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize">

    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="New Reminder" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,25"/>

            <TextBlock Text="Title" Foreground="#CCCCCC" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtTitle" Height="36" Padding="8,6" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" CaretBrush="White"/>

            <TextBlock Text="Message (optional)" Foreground="#CCCCCC" Margin="0,15,0,6"/>
            <TextBox x:Name="TxtMessage" Height="70" Padding="8,6" AcceptsReturn="True" TextWrapping="Wrap"
                     Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" CaretBrush="White"/>

            <TextBlock Text="Date" Foreground="#CCCCCC" Margin="0,15,0,6"/>
            <DatePicker x:Name="DpDate" SelectedDate="{x:Static sys:DateTime.Today}"/>

            <TextBlock Text="Time (24-hour format)" Foreground="#CCCCCC" Margin="0,15,0,6"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtHour" Width="60" Height="36" Text="09" Padding="8,6" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" CaretBrush="White"/>
                <TextBlock Text=" : " Foreground="White" VerticalAlignment="Center" FontSize="18"/>
                <TextBox x:Name="TxtMinute" Width="60" Height="36" Text="00" Padding="8,6" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" CaretBrush="White"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                <Button Content="Cancel" Width="90" Height="36" Margin="0,0,12,0" Click="BtnCancel_Click"/>
                <Button Content="Save" Width="100" Height="36" Background="#007ACC" Foreground="White" BorderThickness="0" Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>