<Window x:Class="HabitTracker.AddReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HabitTracker.Controls"
        Title="Add Reminder"
        Icon="Assets/Icon.ico"
        Height="580" Width="400"
        MinHeight="520" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="CanResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <TextBlock Text="New Reminder" Style="{DynamicResource SectionTitleStyle}" Margin="0,0,0,25"/>

            <TextBlock Text="Title" Style="{DynamicResource FieldLabelStyle}"/>
            <TextBox x:Name="TxtTitle" Style="{DynamicResource AppTextBoxStyle}"/>

            <TextBlock Text="Message (optional)" Style="{DynamicResource FieldLabelStyle}" Margin="0,15,0,6"/>
            <TextBox x:Name="TxtMessage" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                     Style="{DynamicResource AppTextBoxStyle}"/>

            <TextBlock Text="Date" Style="{DynamicResource FieldLabelStyle}" Margin="0,15,0,6"/>
            <controls:AppDatePickerButton x:Name="DpDate"/>

            <TextBlock Text="Time (24-hour format)" Style="{DynamicResource FieldLabelStyle}" Margin="0,15,0,6"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtHour" Width="60" Style="{DynamicResource AppTextBoxStyle}"/>
                <TextBlock Text=" : " Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" FontSize="18"/>
                <TextBox x:Name="TxtMinute" Width="60" Style="{DynamicResource AppTextBoxStyle}"/>
            </StackPanel>
            <TextBlock Text="Defaults to a few minutes from now" Style="{DynamicResource MutedTextStyle}" Margin="0,6,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,10">
                <Button Content="Cancel" Width="90" Height="38" Margin="0,0,12,0" Click="BtnCancel_Click"
                        Style="{DynamicResource SecondaryButtonStyle}"/>
                <Button Content="Save" Width="100" Height="38" Click="BtnSave_Click"
                        Style="{DynamicResource PrimaryButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
