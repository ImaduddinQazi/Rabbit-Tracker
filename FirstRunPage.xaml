<Page x:Class="HabitTracker.FirstRunPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E1E"
      Title="Welcome">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">

            <TextBlock Text="Welcome to Habit Tracker"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Name -->
            <TextBlock Text="What is your name?"
                       Foreground="#CCCCCC"
                       FontSize="16"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="TxtName"
                     Height="40"
                     FontSize="16"
                     Padding="10,8"
                     Background="#2D2D30"
                     Foreground="White"
                     BorderBrush="#3F3F46"
                     CaretBrush="White"/>

            <!-- Theme -->
            <TextBlock Text="Choose Theme"
                       Foreground="#CCCCCC"
                       FontSize="16"
                       Margin="0,30,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton x:Name="RbDark"
                             Content="Dark"
                             IsChecked="True"
                             Foreground="White"
                             FontSize="15"
                             Margin="0,0,30,0"
                             GroupName="Theme"/>

                <RadioButton x:Name="RbLight"
                             Content="Light"
                             Foreground="White"
                             FontSize="15"
                             GroupName="Theme"/>
            </StackPanel>

            <!-- Continue Button -->
            <Button Content="Continue"
                    Height="45"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,40,0,0"
                    Background="#007ACC"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnContinue_Click"/>
        </StackPanel>
    </Grid>
</Page>