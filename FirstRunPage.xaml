<Page x:Class="HabitTracker.FirstRunPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBackgroundBrush}"
      Title="Welcome">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">

            <!-- <TextBlock Text="&#128007;" FontSize="46" HorizontalAlignment="Center" Margin="0,0,0,10"/> -->

            <TextBlock Text="Welcome to Rabbit Tracker"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Name -->
            <TextBlock Text="What is your name?" Style="{DynamicResource FieldLabelStyle}" FontSize="16" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtName" Style="{DynamicResource AppTextBoxStyle}" MinHeight="44" FontSize="16"/>

            <!-- Continue Button -->
            <Button Content="Continue"
                    Height="46"
                    FontSize="16"
                    Margin="0,40,0,0"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Click="BtnContinue_Click"/>
        </StackPanel>
    </Grid>
</Page>
