<Window x:Class="HabitTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Habit Tracker"
        Height="720" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#252526" Padding="15,0">
            <Grid>
                <TextBlock x:Name="TxtUserName" 
                           VerticalAlignment="Center" 
                           Foreground="#CCCCCC" 
                           FontSize="14"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnAddReminder" 
                            Content="+ Reminder" 
                            Height="30" Width="100"
                            Margin="0,0,15,0"
                            Background="#3F3F46" Foreground="White" BorderThickness="0"
                            Click="BtnAddReminder_Click"/>

                    <Button x:Name="BtnNotifications" 
                            Content="🔔" 
                            Width="40" Height="30"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            FontSize="16"
                            Click="BtnNotifications_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Side Menu -->
            <Border Grid.Column="0" Background="#252526" Padding="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Habit Tracker"
                               FontSize="20" FontWeight="Bold"
                               Foreground="White" Margin="20,0,0,30"/>

                    <Button x:Name="BtnDashboard" Content="Dashboard"
                            Style="{StaticResource MenuButtonStyle}" Click="BtnDashboard_Click"/>
                    <Button x:Name="BtnDailyGoals" Content="Daily Goals"
                            Style="{StaticResource MenuButtonStyle}" Click="BtnDailyGoals_Click"/>
                    <Button x:Name="BtnDiary" Content="Diary"
                            Style="{StaticResource MenuButtonStyle}" Click="BtnDiary_Click"/>
                </StackPanel>
            </Border>

            <!-- Page Content -->
            <Border Grid.Column="1" Background="#1E1E1E">
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
            </Border>
        </Grid>

        <!-- Notification Popup Panel (hidden by default) -->
        <Border x:Name="NotificationPanel"
                Grid.Row="1"
                Width="320"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,15,0"
                Background="#2D2D30"
                CornerRadius="8"
                Visibility="Collapsed"
                Padding="15">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Notifications" 
                           FontWeight="SemiBold" Foreground="White" FontSize="16" Margin="0,0,0,12"/>
                <ScrollViewer Height="350" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NotificationsList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>