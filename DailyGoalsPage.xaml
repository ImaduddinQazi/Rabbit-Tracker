<Page x:Class="HabitTracker.DailyGoalsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E1E"
      Title="Daily Goals">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Daily Goals"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <Button Content="+ Add Goal"
                    Width="130"
                    Height="38"
                    Margin="25,0,0,0"
                    Background="#007ACC"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    Cursor="Hand"
                    Click="BtnAddGoal_Click"/>
        </StackPanel>

        <!-- Today -->
        <TextBlock x:Name="TxtToday"
                   Grid.Row="1"
                   FontSize="14"
                   Foreground="#AAAAAA"
                   Margin="0,0,0,18"/>

        <!-- Goals List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GoalsPanel"/>
        </ScrollViewer>
    </Grid>
</Page>