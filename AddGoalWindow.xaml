<Window x:Class="HabitTracker.AddGoalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Add New Goal"
        Height="520" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize">

    <Grid Margin="25">
        <StackPanel>

            <TextBlock Text="Add New Goal" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,25"/>

            <!-- Title -->
            <TextBlock Text="Goal Title" Foreground="#CCCCCC" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtTitle" Height="36" Padding="8,6" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" CaretBrush="White"/>

            <!-- Target Count -->
            <TextBlock Text="Target Count (times per day)" Foreground="#CCCCCC" Margin="0,18,0,6"/>
            <TextBox x:Name="TxtCount" Height="36" Padding="8,6" Text="1" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46" CaretBrush="White"/>

            <!-- Start & End Date -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Start Date" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                    <DatePicker x:Name="DpStart" SelectedDate="{x:Static sys:DateTime.Today}" Background="#2D2D30"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="End Date" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                    <DatePicker x:Name="DpEnd" SelectedDate="{x:Static sys:DateTime.Today}" Background="#2D2D30"/>
                </StackPanel>
            </Grid>

            <!-- Repeat Type -->
            <TextBlock Text="Repeat" Foreground="#CCCCCC" Margin="0,20,0,8"/>
            <ComboBox x:Name="CmbRepeat" Height="34" SelectedIndex="0" SelectionChanged="CmbRepeat_SelectionChanged">
                <ComboBoxItem Content="Everyday"/>
                <ComboBoxItem Content="Weekdays (Mon-Fri)"/>
                <ComboBoxItem Content="Weekends (Sat-Sun)"/>
                <ComboBoxItem Content="Only Saturday"/>
                <ComboBoxItem Content="Only Sunday"/>
                <ComboBoxItem Content="Custom days..."/>
            </ComboBox>

            <!-- Custom Days (hidden by default) -->
            <StackPanel x:Name="CustomDaysPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <WrapPanel>
                    <CheckBox x:Name="CbMon" Content="Mon" Foreground="White" Margin="0,0,12,8"/>
                    <CheckBox x:Name="CbTue" Content="Tue" Foreground="White" Margin="0,0,12,8"/>
                    <CheckBox x:Name="CbWed" Content="Wed" Foreground="White" Margin="0,0,12,8"/>
                    <CheckBox x:Name="CbThu" Content="Thu" Foreground="White" Margin="0,0,12,8"/>
                    <CheckBox x:Name="CbFri" Content="Fri" Foreground="White" Margin="0,0,12,8"/>
                    <CheckBox x:Name="CbSat" Content="Sat" Foreground="White" Margin="0,0,12,8"/>
                    <CheckBox x:Name="CbSun" Content="Sun" Foreground="White" Margin="0,0,12,8"/>
                </WrapPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                <Button Content="Cancel" Width="90" Height="36" Margin="0,0,12,0" Click="BtnCancel_Click"/>
                <Button Content="Save Goal" Width="110" Height="36" Background="#007ACC" Foreground="White" BorderThickness="0" Click="BtnSave_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>