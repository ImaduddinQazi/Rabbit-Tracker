<Window x:Class="HabitTracker.AddGoalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HabitTracker.Controls"
        Title="Add New Goal"
        Icon="Assets/Icon.ico"
        Height="660" Width="440"
        MinHeight="560" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="CanResize">

    <!-- The whole form lives inside a ScrollViewer as a safety net: no matter
         how much extra content appears (custom day checkboxes, etc.) the
         Save/Cancel buttons stay reachable by scrolling. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="25">

            <TextBlock Text="Add New Goal" Style="{DynamicResource SectionTitleStyle}" Margin="0,0,0,25"/>

            <!-- Title -->
            <TextBlock Text="Goal Title" Style="{DynamicResource FieldLabelStyle}"/>
            <TextBox x:Name="TxtTitle" Style="{DynamicResource AppTextBoxStyle}"/>

            <!-- Target Count -->
            <TextBlock Text="Target Count (times per day)" Style="{DynamicResource FieldLabelStyle}" Margin="0,18,0,6"/>
            <TextBox x:Name="TxtCount" Text="1" Style="{DynamicResource AppTextBoxStyle}"/>

            <!-- Start & End Date -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Start Date" Style="{DynamicResource FieldLabelStyle}"/>
                    <controls:AppDatePickerButton x:Name="DpStart"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="End Date" Style="{DynamicResource FieldLabelStyle}"/>
                    <controls:AppDatePickerButton x:Name="DpEnd"/>
                </StackPanel>
            </Grid>

            <!-- Repeat Type -->
            <TextBlock Text="Repeat" Style="{DynamicResource FieldLabelStyle}" Margin="0,20,0,8"/>
            <controls:AppDropdown x:Name="CmbRepeat" SelectionChanged="CmbRepeat_SelectionChanged"/>

            <!-- Custom Days (hidden by default) -->
            <StackPanel x:Name="CustomDaysPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <WrapPanel>
                    <CheckBox x:Name="CbMon" Content="Mon" Style="{DynamicResource AppCheckBoxStyle}"/>
                    <CheckBox x:Name="CbTue" Content="Tue" Style="{DynamicResource AppCheckBoxStyle}"/>
                    <CheckBox x:Name="CbWed" Content="Wed" Style="{DynamicResource AppCheckBoxStyle}"/>
                    <CheckBox x:Name="CbThu" Content="Thu" Style="{DynamicResource AppCheckBoxStyle}"/>
                    <CheckBox x:Name="CbFri" Content="Fri" Style="{DynamicResource AppCheckBoxStyle}"/>
                    <CheckBox x:Name="CbSat" Content="Sat" Style="{DynamicResource AppCheckBoxStyle}"/>
                    <CheckBox x:Name="CbSun" Content="Sun" Style="{DynamicResource AppCheckBoxStyle}"/>
                </WrapPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,10">
                <Button Content="Cancel" Width="90" Height="38" Margin="0,0,12,0" Click="BtnCancel_Click"
                        Style="{DynamicResource SecondaryButtonStyle}"/>
                <Button Content="Save Goal" Width="120" Height="38" Click="BtnSave_Click"
                        Style="{DynamicResource PrimaryButtonStyle}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
