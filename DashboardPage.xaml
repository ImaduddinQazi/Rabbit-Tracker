<Page x:Class="HabitTracker.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E1E"
      Title="Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30,40,40">

            <!-- Greeting -->
            <TextBlock x:Name="TxtGreeting"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Here's your activity overview"
                       FontSize="15"
                       Foreground="#AAAAAA"
                       Margin="0,0,0,30"/>

            <!-- Stats Cards -->
            <UniformGrid Columns="3" Margin="0,0,0,35">
                <!-- Card 1 -->
                <Border Background="#2D2D30" CornerRadius="10" Padding="20" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="Today's Goals" Foreground="#AAAAAA" FontSize="13"/>
                        <TextBlock x:Name="TxtTodayGoals" Text="0 / 0" 
                                   FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2 -->
                <Border Background="#2D2D30" CornerRadius="10" Padding="20" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="Current Streak" Foreground="#AAAAAA" FontSize="13"/>
                        <TextBlock x:Name="TxtStreak" Text="0 days" 
                                   FontSize="26" FontWeight="Bold" Foreground="#4EC9B0" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3 -->
                <Border Background="#2D2D30" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="This Year Activity" Foreground="#AAAAAA" FontSize="13"/>
                        <TextBlock x:Name="TxtYearActivity" Text="0 days" 
                                   FontSize="26" FontWeight="Bold" Foreground="#569CD6" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Yearly Activity Title -->
            <TextBlock Text="Yearly Activity"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="0,0,0,15"/>

            <!-- GitHub-style Heatmap -->
            <Border Background="#252526" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="TxtYearLabel" 
                               Text="2026" 
                               Foreground="#CCCCCC" 
                               FontSize="14" 
                               Margin="0,0,0,12"/>

                    <!-- Heatmap Grid -->
                    <Grid x:Name="HeatmapGrid" Height="120"/>

                    <!-- Legend -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <TextBlock Text="Less" Foreground="#888888" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Width="12" Height="12" Background="#2D2D30" Margin="2,0" CornerRadius="2"/>
                        <Border Width="12" Height="12" Background="#0E4429" Margin="2,0" CornerRadius="2"/>
                        <Border Width="12" Height="12" Background="#006D32" Margin="2,0" CornerRadius="2"/>
                        <Border Width="12" Height="12" Background="#26A641" Margin="2,0" CornerRadius="2"/>
                        <Border Width="12" Height="12" Background="#39D353" Margin="2,0" CornerRadius="2"/>
                        <TextBlock Text="More" Foreground="#888888" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Quick Tip -->
            <TextBlock Text="Tip: Complete Daily Goals and write in Diary to fill the activity graph."
                       Foreground="#666666"
                       FontSize="13"
                       Margin="0,25,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>