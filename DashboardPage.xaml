<Page x:Class="HabitTracker.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBackgroundBrush}"
      Title="Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30,40,40">

            <TextBlock x:Name="TxtGreeting" Style="{DynamicResource PageTitleStyle}" Margin="0,0,0,8"/>
            <TextBlock Text="Here's your activity overview" Style="{DynamicResource PageSubtitleStyle}" Margin="0,0,0,22"/>

            <!-- Quick Actions -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                <Button Content="&#127919; Add Goal" Style="{DynamicResource QuickActionButtonStyle}" Click="BtnQuickAddGoal_Click"/>
                <Button Content="&#128220; Write Diary" Style="{DynamicResource QuickActionButtonStyle}" Click="BtnQuickDiary_Click"/>
                <Button Content="&#9200; Add Reminder" Style="{DynamicResource QuickActionButtonStyle}" Click="BtnQuickAddReminder_Click"/>
            </StackPanel>

            <!-- Stats Cards: WrapPanel reflows the cards responsively as the window is resized -->
            <WrapPanel Margin="0,0,0,10">
                <Border Style="{DynamicResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Today's Goals" Style="{DynamicResource MutedTextStyle}"/>
                        <TextBlock x:Name="TxtTodayGoals" Text="0 / 0" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Current Streak" Style="{DynamicResource MutedTextStyle}"/>
                        <TextBlock x:Name="TxtStreak" Text="0 days" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Best Streak" Style="{DynamicResource MutedTextStyle}"/>
                        <TextBlock x:Name="TxtBestStreak" Text="0 days" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="This Year Activity" Style="{DynamicResource MutedTextStyle}"/>
                        <TextBlock x:Name="TxtYearActivity" Text="0 days" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Yearly Activity Heatmap (now built from real goal-completion + diary data) -->
            <TextBlock Text="Yearly Activity" Style="{DynamicResource SectionTitleStyle}" Margin="0,20,0,15"/>

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock x:Name="TxtYearLabel" Text="2026" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,12"/>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="HeatmapGrid" Height="120"/>
                    </ScrollViewer>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <TextBlock Text="Less" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Width="12" Height="12" Background="{DynamicResource HeatmapLevel0}" Margin="2,0" CornerRadius="2"/>
                        <Border Width="12" Height="12" Background="{DynamicResource HeatmapLevel1}" Margin="2,0" CornerRadius="2"/>
                        <Border Width="12" Height="12" Background="{DynamicResource HeatmapLevel2}" Margin="2,0" CornerRadius="2"/>
                        <Border Width="12" Height="12" Background="{DynamicResource HeatmapLevel3}" Margin="2,0" CornerRadius="2"/>
                        <Border Width="12" Height="12" Background="{DynamicResource HeatmapLevel4}" Margin="2,0" CornerRadius="2"/>
                        <TextBlock Text="More" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Upcoming Reminders -->
            <TextBlock Text="Upcoming Reminders" Style="{DynamicResource SectionTitleStyle}" Margin="0,0,0,15"/>
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel x:Name="UpcomingRemindersPanel"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
